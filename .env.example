# Copy this file to .env and set the key locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
HOST=127.0.0.1
# Test subscription only: no payment details, charges or automatic renewals.
ENABLE_DEMO_BILLING=true
# Use true behind HTTPS when hosting publicly.
COOKIE_SECURE=false
DATABASE_PATH=.data/promptforge.sqlite
